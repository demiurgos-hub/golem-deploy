# Build output
bin/
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Default data directory of golem-deploy (--data-dir) and stray databases
data/
*.db
*.db-wal
*.db-shm

# Frontend (frontend/dist/.gitkeep is committed so go:embed works on a fresh clone)
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep

# TLS material
*.pem
*.crt
*.key
*.csr
*.cert

# Logs and temporary files
*.log
tmp/
temp/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
